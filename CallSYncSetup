function doGet() {
  return ContentService
    .createTextOutput("Android Call Logger is working!");
}

function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);

  const sheet = SpreadsheetApp
  .openById("1kjgHW3Ak4HM1VN47lI9_6hd-9CNAuC8LkueV6mZqWZY")
  .getSheetByName("Sheet1");
    sheet.appendRow([
      data.date || "",
      data.time || "",
      data.type || "",
      data.name || "",
      data.number || "",
      data.duration || "",
      data.sim || ""
    ]);

    return ContentService
      .createTextOutput(JSON.stringify({
        status: "success"
      }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {

    return ContentService
      .createTextOutput(JSON.stringify({
        status: "error",
        message: error.toString()
      }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}
